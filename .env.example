# MediaDrop Environment Configuration

# Server
PORT=3000
NODE_ENV=development

# Storage Limits
TEMP_STORAGE_DIR=tmp/downloads
MAX_DOWNLOAD_SIZE_MB=500
TEMP_FILE_TTL_MINUTES=30
CLEANUP_INTERVAL_MINUTES=10

# Security & Rate Limiting
TOKEN_SECRET=mediadrop-super-secure-cryptographic-token-secret-replace-in-prod
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
REQUEST_TIMEOUT_MS=30000
DOWNLOAD_TIMEOUT_MS=180000

# Worker & Queue
USE_REDIS=false
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=3

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mediadrop?schema=public

# Optional Custom Binary Overrides
YT_DLP_PATH=
PYTHON_PATH=python
